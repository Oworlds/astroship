---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted" | "ghost";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
};

const styles = {
  outline:
    "bg-transparent border-2 border-primary hover:bg-primary/10 text-primary",
  primary:
    "bg-primary text-primary-foreground hover:bg-primary-hover border-2 border-transparent",
  inverted:
    "bg-primary text-primary-foreground border-2 border-transparent hover:bg-primary-hover",
  muted:
    "bg-card text-muted-foreground hover:text-foreground border-2 border-border",
  ghost:
    "bg-transparent border border-primary text-primary hover:bg-primary/10",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded-sm text-center transition focus-visible:ring-2 ring-offset-2 ring-offset-background ring-ring",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
