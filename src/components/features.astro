---
// @ts-ignore
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "AI-Powered Question Banks",
    description:
      "Import AI-generated question banks as JSON and start a block in seconds — no accounts, no paywalls, no locked content.",
    icon: "bx:bxs-bot",
  },
  {
    title: "Realistic NBME Interface",
    description:
      "Practice with highlights, strike-through, flagging, a timer, lab values, and a calculator — the same tools you get on test day.",
    icon: "bx:bxs-window-alt",
  },
  {
    title: "Smart Analytics",
    description:
      "See how you perform by system and topic so you can spend study time on the gaps that actually move your score.",
    icon: "bx:bxs-data",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-white">
    Everything you need to study like it's exam day
  </h2>
  <p class="text-lg mt-4 text-zinc-400 max-w-2xl">
    Oworld is free, student-built, and open source. It recreates the NBME
    testing experience entirely in your browser.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-10 gap-4">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start bg-[#121212] border border-zinc-800/80 rounded-xl p-5">
        <div class="mt-0.5 bg-zinc-900 border border-zinc-800 rounded-md p-2 w-9 h-9 shrink-0 text-zinc-300">
          <Icon class="w-full h-full" name={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg text-white">{item.title}</h3>
          <p class="text-zinc-400 mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
