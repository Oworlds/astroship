---
import Container from "@/components/container.astro";
---

<Container>
  <header class="flex justify-between items-center my-5">
    <a href="/" class="text-lg"
      ><span class="font-bold tracking-wide text-zinc-100">OWORLD</span>
    </a>
    <a
      href="https://app.oworld.pro"
      class="inline-flex items-center justify-center px-4 py-2 rounded-lg border border-zinc-700 bg-zinc-900/60 text-zinc-200 text-sm font-medium hover:bg-zinc-800 hover:text-white hover:border-zinc-500 transition-all">
      Launch Oworld
    </a>
  </header>
</Container>
